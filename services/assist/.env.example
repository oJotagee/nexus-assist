# Assist: login, conversas, central de ajuda e o agent
PORT=8081

DATABASE_URL="postgresql://admin:admin@localhost:5432/nexo_assist"

# Assina o accessToken (JWT HS256) emitido no login. Mínimo de 32 caracteres.
JWT_SECRET="change-me-to-a-long-random-jwt-secret-32+"
JWT_EXPIRES_IN="12h"

# Serviço de chamados (rede interna) e o segredo compartilhado com ele
TICKETS_API_URL="http://localhost:8082"
INTERNAL_API_SECRET="change-me-to-a-long-random-string-32+"

# LLM do agent. Padrão: Gemini Flash no plano GRATUITO do Google AI Studio (sem cartão).
# Gere a chave em https://aistudio.google.com/apikey. Sem chave, o chat avisa que o
# assistente está indisponível e o resto do sistema funciona.
AGENT_PROVIDER="google"
AGENT_MODEL="gemini-3.8-flash"
GOOGLE_GENERATIVE_AI_API_KEY=""

# Opcional: Anthropic (pago). Use AGENT_PROVIDER="anthropic" e AGENT_MODEL="claude-opus-5-5".
ANTHROPIC_API_KEY=""

# Teto diário de tokens por funcionário (protege o deploy contra abuso e custo)
DAILY_TOKEN_BUDGET="200000"

# Rate limit por funcionário (ou IP no login), por minuto
RATE_LIMIT_PER_MINUTE="120"
RATE_LIMIT_MESSAGES_PER_MINUTE="12"
RATE_LIMIT_LOGIN_PER_MINUTE="10"

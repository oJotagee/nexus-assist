# Assist: login, conversas, central de ajuda e o agent
PORT=8081

DATABASE_URL="postgresql://admin:admin@localhost:5432/nexo_assist"

# Assina o accessToken (JWT HS256) emitido no login. Mínimo de 32 caracteres.
JWT_SECRET="change-me-to-a-long-random-jwt-secret-32+"
JWT_EXPIRES_IN="12h"

# Serviço de chamados (rede interna) e o segredo compartilhado com ele
TICKETS_API_URL="http://localhost:8082"
INTERNAL_API_SECRET="change-me-to-a-long-random-string-32+"

# LLM (Anthropic). Sem chave, o chat responde com aviso de agent indisponível.
ANTHROPIC_API_KEY=""
# Padrão: claude-opus-5-5 (mais capaz). Para cortar custo por conversa ~40x: claude-haiku-5-5
# (rode `bun run eval --model claude-haiku-5-5` para comparar a qualidade antes de trocar).
AGENT_MODEL="claude-opus-5-5"
# Teto diário de tokens por funcionário (protege o deploy contra abuso e custo)
DAILY_TOKEN_BUDGET="200000"

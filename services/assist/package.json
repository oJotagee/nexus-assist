{
  "name": "@nexo/assist",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=.env --watch src/main.ts",
    "build": "prisma generate",
    "start": "prisma migrate deploy && bun run src/main.ts",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "seed": "SEED_IF_EMPTY=true bun prisma/seed.ts",
    "seed:reset": "bun prisma/seed.ts",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "eval": "bun tests/evals/run-evals.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.90",
    "@ai-sdk/google": "^4.0.107",
    "@mastra/core": "^1.79.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.7.1",
    "@nexo/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.17",
    "@types/express": "^5.0.6",
    "bun-types": "1.4.2",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "typescript": "^5.9.3"
  }
}

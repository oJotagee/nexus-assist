# Serviço de chamados (sistema legado simulado) — só a rede interna fala com ele
PORT=8082

DATABASE_URL="postgresql://admin:admin@localhost:5432/nexo_tickets"

# Segredo compartilhado com o assist (header X-Internal-Secret). Mínimo de 32 caracteres.
INTERNAL_API_SECRET="change-me-to-a-long-random-string-32+"

# Simula a instabilidade do legado: fração das requisições /internal que respondem 503
# e latência extra aleatória (ms). Use 0 para desligar.
TICKETS_FAILURE_RATE="0.15"
TICKETS_MAX_LATENCY_MS="400"

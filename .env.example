# Cada serviço lê o próprio .env, como no booktattoo:
#
#   cp services/tickets/.env.example services/tickets/.env
#   (services/assist e frontend entram nos próximos marcos)
#
# Este arquivo (copiado para .env na raiz) só alimenta o docker-compose.yml.
# Todos os valores têm default para rodar localmente; troque os segredos no deploy.

# Segredo compartilhado entre assist e tickets (header X-Internal-Secret). Mínimo de 32 caracteres.
INTERNAL_API_SECRET=local-dev-internal-secret-0123456789

# Instabilidade simulada do sistema de chamados legado
TICKETS_FAILURE_RATE=0.15
TICKETS_MAX_LATENCY_MS=400
